               FpImageDevice *dev)
@@ -316,11 +402,44 @@ submit_image (FpiSsm        *ssm,
   FpiDeviceNb2033 *self = FPI_DEVICE_NB2033 (dev);
   FpImage *img;
 
+
+
   img = fp_image_new (FRAME_WIDTH, FRAME_HEIGHT);
   if (img == NULL)
     return FALSE;
 
   memcpy (img->data, self->scanline_buf, FRAME_WIDTH * FRAME_HEIGHT);
+  /* NBIS minutiae extraction is scale-parameterised: without a real ppmm the
+   * ridge-spacing expectations fall back to nonsense and quality drops
+   * erratically. The platen is 508 dpi, i.e. 20 px/mm. */
+  img->ppmm = 20.0;
+  nb2033_enhance_frame (img->data, FRAME_WIDTH, FRAME_HEIGHT);
+
+  /* Reject a frame that carries no ridge structure at all: a thermal sensor
+   * reads almost flat when the finger only grazed the platen. Retake in the
+   * same press rather than handing bozorth3 a frame that cannot match. */
+  {
+    double sum = 0.0, sumsq = 0.0, mean, variance;
+    gsize i, n = (gsize) FRAME_WIDTH * FRAME_HEIGHT;
+
+    for (i = 0; i < n; i++)
+      {
+        sum += img->data[i];
+        sumsq += (double) img->data[i] * img->data[i];
+      }
+    mean = sum / n;
+    variance = sumsq / n - mean * mean;
+
+    if (variance < 90.0 && self->poor_frame_retries < 3)
+      {
+        fp_dbg ("frame too flat (variance %.0f), retaking", variance);
+        self->poor_frame_retries++;
+        g_object_unref (img);
+        return FALSE;
+      }
+  }
+
+  self->poor_frame_retries = 0;
   fpi_image_device_image_captured (dev, img);
 
   return TRUE;
