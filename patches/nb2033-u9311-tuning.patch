+/* Preprocessing for the raw thermal frame.
+ *
+ * The sensor delivers an 8-bit grayscale frame that carries a strong
+ * per-row offset (horizontal banding) and a slowly varying illumination
+ * across the platen. Both hurt minutiae extraction far more than the
+ * matching threshold does, so flatten the frame before it reaches
+ * bozorth3: remove each row's mean, then subtract a box-blurred copy of
+ * the image to normalize local contrast and stretch the remainder.
+ */
+static void
+nb2033_enhance_frame (guint8 *data, int w, int h)
+{
+  /* Radius must span several ridge periods (~10 px each at 20 px/mm);
+   * a window near one period erases the ridges it is meant to keep. */
+  const int radius = 40;
+  gint64 *integral;
+  gint64 total = 0;
+  double mean;
+  int x, y;
+
+  /* Pass 1: per-row mean removal (kills horizontal banding). */
+  for (y = 0; y < h; y++)
+    {
+      guint8 *row = data + y * w;
+      int sum = 0;
+
+      for (x = 0; x < w; x++)
+        sum += row[x];
+      mean = (double) sum / w;
+
+      for (x = 0; x < w; x++)
+        {
+          int v = (int) (row[x] - mean + 128.0);
+          row[x] = CLAMP (v, 0, 255);
+        }
+    }
+
+  /* Pass 2: box blur via a summed-area table (w+1 by h+1). */
+  integral = g_new0 (gint64, (gsize) (w + 1) * (h + 1));
+
+  for (y = 0; y < h; y++)
+    {
+      gint64 rowsum = 0;
+
+      for (x = 0; x < w; x++)
+        {
+          rowsum += data[y * w + x];
+          integral[(y + 1) * (w + 1) + (x + 1)] =
+            rowsum + integral[y * (w + 1) + (x + 1)];
+        }
+    }
+
+  /* Pass 3: subtract the local background, then stretch what is left. */
+  total = integral[h * (w + 1) + w];
+  mean = (double) total / ((double) w * h);
+
+  for (y = 0; y < h; y++)
+    {
+      int y0 = MAX (0, y - radius);
+      int y1 = MIN (h, y + radius + 1);
+
+      for (x = 0; x < w; x++)
+        {
+          int x0 = MAX (0, x - radius);
+          int x1 = MIN (w, x + radius + 1);
+          gint64 sum = integral[y1 * (w + 1) + x1]
+                       - integral[y0 * (w + 1) + x1]
+                       - integral[y1 * (w + 1) + x0]
+                       + integral[y0 * (w + 1) + x0];
+          double area = (double) (y1 - y0) * (x1 - x0);
+          double local = (double) sum / area;
+          double v = 128.0 + ((double) data[y * w + x] - local) * 2.0 + (mean - 128.0) * 0.0;
+
+          data[y * w + x] = CLAMP ((int) v, 0, 255);
+        }
+    }
+
+  g_free (integral);
+}
